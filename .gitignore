# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets (never commit real secrets — see workflow-secrets)
.env
.env.*
!.env.example

# Ghidra projects / analysis artifacts (may derive from hostile binaries — never commit)
*.gpr
*.rep/
*.lock
# ...but the Python hash-pinned dependency lockfiles ARE the supply-chain source of truth — track them.
!requirements.lock
!requirements-dev.lock
!requirements-sast.lock
!uv.lock
ghidra_projects/
samples/        # binary samples are not committed; tests use synthetic fixtures

# Containers / build
*.tar
*.sif

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local state (agent worktrees, session) — never commit
.claude/
