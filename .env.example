# ghidra-mcp — example environment configuration (PLACEHOLDERS ONLY — NEVER put real secrets here).
# Copy to `.env` (git-ignored) for local dev. Config is read from the environment (12-Factor);
# the app validates these at startup and FAILS CLOSED on missing/invalid required values.
#
# v1 has NO secrets (single stdio process, no network, no auth boundary). This file documents the
# non-secret operational knobs only. If a future increment (HTTP transport, v1.1) introduces a
# credential, it comes from the secret manager at runtime — NOT from this file (workflow-secrets).

# --- Logging / observability (topic-logging-observability) ---
GHIDRA_MCP_LOG_LEVEL=INFO            # DEBUG|INFO|WARNING|ERROR. DEBUG must never emit binary content.
GHIDRA_MCP_LOG_FORMAT=json           # json|text. Structured JSON to stdout/stderr in prod.

# --- Sessions (PLAN §2: persistent per-binary, TTL + idle eviction) ---
GHIDRA_MCP_SESSION_TTL_SECONDS=3600          # absolute session lifetime before eviction.
GHIDRA_MCP_SESSION_IDLE_SECONDS=900          # idle timeout before eviction.
GHIDRA_MCP_MAX_SESSIONS=4                     # worker-pool concurrency cap (backpressure above this).

# --- DoS / resource bounds enforced BEFORE the worker (PLAN §3 F7, ADR maps to security/limits) ---
GHIDRA_MCP_MAX_BINARY_BYTES=134217728        # 128 MiB hard cap on imported binary size.
GHIDRA_MCP_ANALYSIS_TIMEOUT_SECONDS=600      # per-analysis wall-clock; on expiry the worker is KILLED.
GHIDRA_MCP_TOOL_TIMEOUT_SECONDS=60           # per-tool-call wall-clock (e.g. one decompile).
GHIDRA_MCP_MAX_RESPONSE_BYTES=4194304        # 4 MiB cap on any single tool response payload.

# --- Worker / Ghidra (container-only — ADR-003). Pinned BY DIGEST in deploy/, not by tag. ---
GHIDRA_MCP_WORKER_IMAGE=ghcr.io/0xb007ab1e/ghidra-mcp-worker@sha256:921cd0ec9b2fbf2456b405acdd0ab8c4458c1cd4424d55f7d3d4539300f2c3c7
GHIDRA_MCP_WORKER_RUNTIME=runsc              # container runtime: runsc (gVisor) for the worker (ADR-004).
GHIDRA_MCP_WORKER_UID=65532                  # worker container uid (hardened non-root default). Must own the
GHIDRA_MCP_WORKER_GID=65532                  # socket dir under --userns keep-id; a host-run server aligns these to its own uid (ADR-009).
GHIDRA_MCP_RPC_SOCKET_DIR=/run/ghidra-mcp    # dir for per-session Unix domain sockets (see contracts).
GHIDRA_MCP_IMPORT_ROOT=/work/imports         # host dir (ro-mounted into the worker) holding importable inputs; source_ref must resolve under it (ADR-009).
