# vivarium — example environment configuration (PLACEHOLDERS ONLY — NEVER put real secrets here).
# Copy to `.env` (git-ignored) for local dev. Config is read from the environment (12-Factor);
# the app validates these at startup and FAILS CLOSED on missing/invalid required values.
#
# The DEFAULT transport is stdio (single process, no network, no auth boundary). The HTTP transport
# (VIVARIUM_TRANSPORT=http) adds a network boundary with pluggable auth (bearer / mTLS / OAuth /
# reverse-proxy-mTLS); any CREDENTIAL it needs comes from the secret manager at runtime — NEVER from
# this file (workflow-secrets). This file documents the common non-secret operational knobs; the
# FULL configuration reference (every VIVARIUM_* variable, default, and source) is in
# docs/configuration.md.

# --- Logging / observability (topic-logging-observability) ---
VIVARIUM_LOG_LEVEL=INFO            # DEBUG|INFO|WARNING|ERROR. DEBUG must never emit binary content.
VIVARIUM_LOG_FORMAT=json           # json|text. Structured JSON to stdout/stderr in prod.

# --- Sessions (PLAN §2: persistent per-binary, TTL + idle eviction) ---
VIVARIUM_SESSION_TTL_SECONDS=3600          # absolute session lifetime before eviction.
VIVARIUM_SESSION_IDLE_SECONDS=900          # idle timeout before eviction.
VIVARIUM_MAX_SESSIONS=4                     # worker-pool concurrency cap (backpressure above this).
# VIVARIUM_MAX_SESSIONS_PER_OWNER=2         # optional per-principal cap (multi-principal); unset = off (global cap bounds total).

# --- DoS / resource bounds enforced BEFORE the worker (PLAN §3 F7, ADR maps to security/limits) ---
VIVARIUM_MAX_BINARY_BYTES=134217728        # 128 MiB hard cap on imported binary size.
VIVARIUM_ANALYSIS_TIMEOUT_SECONDS=600      # per-analysis wall-clock; on expiry the worker is KILLED.
VIVARIUM_TOOL_TIMEOUT_SECONDS=60           # per-tool-call wall-clock (e.g. one decompile).
VIVARIUM_MAX_RESPONSE_BYTES=4194304        # 4 MiB cap on any single tool response payload.

# --- Worker / Ghidra (container-only — ADR-003). Pinned BY DIGEST in deploy/, not by tag. ---
# Example digest only — the TRUSTED digest CI verifies is .github/worker-image.pin (keep them in sync).
VIVARIUM_WORKER_IMAGE=ghcr.io/0xb007ab1e/vivarium-worker@sha256:94ec766f6def2458a82bf8102fdb4823eb11f92133d20f6d36df662f021e2b9c
VIVARIUM_WORKER_RUNTIME=runsc              # container runtime: runsc (gVisor) for the worker (ADR-004).
VIVARIUM_WORKER_UID=65532                  # worker container uid (hardened non-root default). Must own the
VIVARIUM_WORKER_GID=65532                  # socket dir under --userns keep-id; a host-run server aligns these to its own uid (ADR-009).
VIVARIUM_RPC_SOCKET_DIR=/run/vivarium    # dir for per-session Unix domain sockets (see contracts).
VIVARIUM_IMPORT_ROOT=/work/imports         # host dir (ro-mounted into the worker) holding importable inputs; source_ref must resolve under it (ADR-009).
# VIVARIUM_FID_DB_DIR=/opt/vivarium/fid    # WORKER-ONLY (ADR-043 Phase 2): dir of bundled packed ELF FunctionID DBs (*.fidbf), copied to the writable tmpfs + attached at worker startup so identify_functions matches Linux library code. Fail-soft: missing/empty dir = no-op. Default /opt/vivarium/fid.

# --- Worker container resource bounds (v1.3 — ADR-023 / F1). Tunable but CLAMPED to a hard ceiling
# (env can lower OR raise within bounds; above-ceiling is clamped DOWN — never widen the DoS surface
# past the safe cap; bool/non-int/<1 fail closed). Defaults equal the historical hardcoded caps.
# --memory-swap is pinned EQUAL to --memory (no swap — ADR-004 invariant). ---
# VIVARIUM_WORKER_MEM_MIB=4096             # worker memory cap, MiB (default 4096; ceiling 32768).
# VIVARIUM_WORKER_CPUS=2                   # whole-CPU quota (default 2; ceiling 16).
# VIVARIUM_WORKER_PIDS=512                 # process/thread cap, bounds fork bombs (default 512; ceiling 4096).
# VIVARIUM_WORKER_TMPFS_SCRATCH_MIB=2048   # scratch tmpfs (/tmp/ghidra) size, MiB (default 2048; ceiling 16384).
# VIVARIUM_WORKER_TMPFS_PROJECT_MIB=4096   # project-store tmpfs (/work/project) size, MiB (default 4096; ceiling 32768).

# --- Over-plausible-size pre-flight mode (v1.4 — ADR-029 C). An input larger than ~2x the worker
# memory cap will likely OOM the worker; this knob decides what happens BEFORE the worker is fed.
# warn (default) = log a heads-up (size + configured memory only) and proceed (v1.3 behaviour);
# reject = fail closed with the non-retryable resource-exhausted (503) pre-Ghidra; off = skip.
# An invalid value fails closed at startup (refuse to boot). ---
# VIVARIUM_WORKER_PREFLIGHT=warn           # warn | reject | off  (default warn).

# --- HTTP transport (v1.1 — ADR-011; default transport is stdio). Read ONLY when transport=http.
# Full reference (auth modes, OAuth/mTLS/proxy knobs, CORS, rate limits) in docs/configuration.md.
# SECRETS (bearer tokens, proxy shared secret) come from the secret manager at runtime, NOT here. ---
# VIVARIUM_TRANSPORT=stdio                  # stdio (default) | http.
# VIVARIUM_HTTP_BIND=127.0.0.1:8765         # host:port; bind to a tailnet/loopback address, never 0.0.0.0.
# VIVARIUM_HTTP_AUTH=bearer                 # bearer | mtls | oauth | mtls-proxy (required when transport=http).
# VIVARIUM_HTTP_RATE_PER_SECOND=10          # per-principal request rate (token bucket).
# VIVARIUM_HTTP_RATE_BURST=20               # token-bucket burst.
# VIVARIUM_HTTP_MAX_BODY_BYTES=8388608      # request body cap (8 MiB).
# VIVARIUM_HTTP_CORS_ORIGINS=               # comma-separated allow-list; empty = no cross-origin.
