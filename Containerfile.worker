# syntax=docker/dockerfile:1
# =============================================================================
# Containerfile.worker — hardened, network-isolated Ghidra analysis worker
# =============================================================================
# Realizes ADR-003 (container-only Ghidra 12.1.2 + JDK 21, pinned by digest) and is the image
# hardened at RUNTIME by deploy/ per ADR-004 (rootless, ro-rootfs, all caps dropped, no network,
# seccomp RuntimeDefault, gVisor/runsc, resource limits). This image hosts the WS2 `worker/`
# entrypoint that speaks JSON-RPC 2.0 over the per-session UDS (docs/contracts/rpc-protocol.md).
#
# TRUST BOUNDARY 3 (HOSTILE INPUT): this container parses attacker-controlled binaries through the
# Ghidra JVM. It is a DISPOSABLE fault domain — one worker per session, killed on eviction/timeout
# (ADR-002). It MUST be able to do nothing but read its mounted binary, analyze it, and answer RPC
# on its own socket. No network, no host access, no persistence beyond a session-scoped tmpfs/volume.
#
# -----------------------------------------------------------------------------
# BASE: Chainguard/Wolfi (distroless migration — PLAN §9, worker leg)
# -----------------------------------------------------------------------------
# Migrated OFF `python:3.12-slim` (Debian) + a copied eclipse-temurin JDK to a single Wolfi base
# (`cgr.dev/chainguard/wolfi-base`) with `apk add python-3.12 openjdk-21`. This retires the
# no-upstream-fix Debian-base CVEs (perl-base + ncurses) that `.trivyignore.yaml` waived — Wolfi
# ships no perl and its packages are CVE-tracked/patched (the sibling server image scans Trivy-0).
# The worker stays on **Python 3.12** (matches the PyGhidra/JPype bundled in Ghidra 12.1.2; the
# project's `requires-python = ">=3.12"` covers both this and the 3.14 server). Glibc base, so the
# hash-pinned manylinux wheels (pydantic-core etc.) install unchanged.
#
# Design notes (vs. the shell-free server image):
#   * `wolfi-base` carries apk + a shell — the worker runtime is NOT shell-free (a turnkey
#     python+JDK distroless image does not exist; hand-rolling scratch+CPython+JDK+Ghidra is far
#     more effort for marginal gain over the already-hardened deploy/ runtime — PLAN §9). It is
#     still CVE-clean and non-root.
#   * `apk add` resolves CURRENT package versions at build (auto-patched/CVE-clean) rather than the
#     digest-pinned temurin JDK we used before; reproducibility comes from the digest-pinned base +
#     rebuild currency (idiomatic Wolfi). The base is pinned by digest below (std-supplychain).
#   * Wolfi `python-3.12` ships no pip → bootstrap it with `python3.12 -m ensurepip` (stdlib).
#   * Only `/usr/bin/python3.12` exists (no `python`/`python3`) → a `python` symlink is created so
#     the `python -m worker` entrypoint + the integration driver resolve.
#
# -----------------------------------------------------------------------------
# SUPPLY CHAIN (std-supplychain / ADR-003) — DIGEST PINNING IS GATED (PLAN §6)
# -----------------------------------------------------------------------------
# The base image is pinned BY DIGEST (@sha256:...), NEVER by floating tag, via the
# `@REPLACE_WITH_DIGEST_FOR_<image:tag>` placeholder that `infra/pin-supply-chain.sh` resolves on
# the gated build host. Ghidra is downloaded + CHECKSUM-VERIFIED before unzip (W3 below).
#
#   GATED ITEM W-BASE: cgr.dev/chainguard/wolfi-base (build + runtime; pinned by digest)
#   GATED ITEM W3: Ghidra 12.1.2 release artifact (downloaded + SHA-256-verified, not pulled as image)
# =============================================================================

# --- ARGs (set at build; pinned values are GATED — see notes above) -----------------------------
# Ghidra release version + the publisher's SHA-256 of the release zip (verified during build).
ARG GHIDRA_VERSION=12.1.2
ARG GHIDRA_RELEASE_TAG=Ghidra_12.1.2_build
ARG GHIDRA_ZIP_SHA256=b62e81a0390618466c019c60d8c2f796ced2509c4c1aea4a37644a77272cf99d
ARG GHIDRA_ZIP_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/ghidra_12.1.2_PUBLIC_20260605.zip

# --- ADR-043 Phase 2 (Increment B): bundled zlib ELF FID database source pin -------------------
# zlib upstream source tarball, version-pinned + SHA-256-verified BEFORE extract in the zlib-fidgen
# stage (mirrors the GHIDRA_ZIP_* pattern: fail-closed on checksum mismatch — std-supplychain D4).
# The version MUST match the `zlib` entry in deploy/fid/sources.toml (the CI license/source gate).
# The published sha256 for zlib 1.3.1 (zlib-1.3.1.tar.gz) is the well-known upstream digest below;
# the gated build host re-verifies it (and may repin URL/digest if upstream relocates the artifact).
ARG ZLIB_VERSION=1.3.1
ARG ZLIB_TARBALL_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
ARG ZLIB_TARBALL_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz

# GATED ITEM W-MUSL: musl libc source tarball (downloaded + SHA-256-verified before extract). The
# version MUST match the `musl` entry in deploy/fid/sources.toml (the CI license/source gate). musl
# is MIT (permissive — passes vivarium.fid_licenses) and the static-libc identification workhorse
# (ADR-043 Inc C). The sha256 below is the well-known upstream digest for musl-1.2.5.tar.gz; the
# gated build host re-verifies it (and may repin URL/digest if upstream relocates the artifact).
ARG MUSL_VERSION=1.2.5
ARG MUSL_TARBALL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4
ARG MUSL_TARBALL_URL=https://musl.libc.org/releases/musl-1.2.5.tar.gz

# GATED ITEM W-OPENSSL: OpenSSL source tarball (downloaded + SHA-256-verified before extract). The
# version MUST match the `openssl` entry in deploy/fid/sources.toml. OpenSSL 3.x is Apache-2.0
# (permissive — passes vivarium.fid_licenses; pre-3.0 `OpenSSL`-id is BLOCKED). The highest-RE-value
# DB (crypto primitives). 3.5.x is the LTS line; the sha256 below for openssl-3.5.7.tar.gz is the
# upstream digest published on BOTH github releases and openssl.org; the gated build re-verifies it.
ARG OPENSSL_VERSION=3.5.7
ARG OPENSSL_TARBALL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8
ARG OPENSSL_TARBALL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.7/openssl-3.5.7.tar.gz

# GATED ITEM W-BOOST: Boost source (b2-nodocs tarball; downloaded + SHA-256-verified before extract).
# Version MUST match the `boost` entry in deploy/fid/sources.toml. Boost is BSL-1.0 (permissive —
# passes vivarium.fid_licenses). Most of Boost is header-only (no compiled code → no FID value); this
# DB covers Boost's COMPILED libraries only. The sha256 below for boost-1.89.0-b2-nodocs.tar.gz is the
# upstream digest published alongside the release asset; the gated build re-verifies it.
ARG BOOST_VERSION=1.89.0
ARG BOOST_TARBALL_SHA256=aa25e7b9c227c21abb8a681efd4fe6e54823815ffc12394c9339de998eb503fb
ARG BOOST_TARBALL_URL=https://github.com/boostorg/boost/releases/download/boost-1.89.0/boost-1.89.0-b2-nodocs.tar.gz

# =============================================================================
# Stage 1: ghidra-fetch — fetch + verify + unpack Ghidra. Build tooling stays HERE, not in runtime.
# =============================================================================
# GATED ITEM W-BASE: pin this base by digest.
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS ghidra-fetch

ARG GHIDRA_VERSION
ARG GHIDRA_RELEASE_TAG
ARG GHIDRA_ZIP_SHA256
ARG GHIDRA_ZIP_URL

# Build-only tooling (curl/unzip/ca-certs). Never ships to the runtime stage.
RUN set -eux; \
    apk add --no-cache ca-certificates curl unzip

WORKDIR /opt/ghidra-src

# GATED ITEM W3: download the Ghidra release zip and VERIFY its publisher SHA-256 BEFORE unzip.
# A checksum mismatch FAILS THE BUILD (fail closed — supply-chain integrity, no tampered artifact).
# AB2 (round-12) note: unlike zlib/openssl/musl, the Ghidra release zip is published ONLY as a GitHub
# release asset by the NSA — there is no second host serving a byte-identical (sha-matching) artifact,
# so a fail-over mirror is not available. Accepted: this fetch is on the image-scan-gate path (not the
# FID required gate), GitHub release assets are high-availability, and integrity stays checksum-gated.
RUN set -eux; \
    echo "${GHIDRA_ZIP_SHA256}  ghidra.zip" > ghidra.zip.sha256; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 15 --connect-timeout 60 --proto '=https' --tlsv1.2 -o ghidra.zip "${GHIDRA_ZIP_URL}"; \
    sha256sum -c ghidra.zip.sha256; \
    unzip -q ghidra.zip; \
    rm -f ghidra.zip ghidra.zip.sha256; \
    # The zip extracts to ghidra_<version>_PUBLIC/. Normalize to a stable path.
    mv ghidra_*_PUBLIC /opt/ghidra; \
    # Strip components a headless analyzer never needs, to shrink attack surface + image size.
    #   * docs / DemanglerGnu build artifacts — never used at runtime.
    #   * Features/GhidraServer — the multi-user repository server (run via the bundled yajsw Java
    #     service wrapper, which vendors netty-handler). This worker ONLY runs headless analysis
    #     (analyzeHeadless / PyGhidra) and has NO network listener, so GhidraServer is never invoked.
    #     Removing it drops the vendored netty-handler JAR that carries CVE-2026-44249 (IPv6 subnet
    #     filter bypass) + CVE-2026-45416 (SNI handler over-allocation) — both unreachable here, but
    #     deleting the dead feature is better than waiving (minimize attack surface — master §2).
    rm -rf /opt/ghidra/docs /opt/ghidra/GPL/DemanglerGnu/build \
           /opt/ghidra/Ghidra/Features/GhidraServer 2>/dev/null || true

# =============================================================================
# Stage 2: pybuilder — build the vivarium wheel (PEP 517) so the runtime install is OFFLINE.
# =============================================================================
# Building from a source tree needs a PEP 517 backend (hatchling), which is NOT in requirements.lock
# (the lock pins RUNTIME deps only). Resolving the backend is a network action — confined HERE in a
# builder stage (network during the gated build is already accepted: Ghidra download). Same Wolfi
# base + python-3.12 as runtime → reproducible toolchain; the wheel is pure-Python (py3-none-any).
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS pybuilder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
RUN set -eux; apk add --no-cache python-3.12 "py3-pip-wheel>=26.1.2-r1"  # CVE-2026-44432 (build stage)
WORKDIR /build
COPY pyproject.toml README.md LICENSE NOTICE /build/
COPY src/ /build/src/
# `build` + the hatchling backend are build-only and never ship to runtime. Wolfi python-3.12 has
# no pip → bootstrap via ensurepip. (DL3013 — bare `==` pin — is ignored project-wide; see
# infra/hadolint.yaml justification.)
RUN set -eux; \
    python3.12 -m ensurepip --upgrade; \
    python3.12 -m pip install --no-cache-dir build hatchling; \
    python3.12 -m build --wheel --outdir /build/dist /build

# =============================================================================
# Stage 3: runtime — Wolfi + Python 3.12 + JDK 21 + Ghidra + PyGhidra + the worker code. No build
# tools beyond what apk/ensurepip need for the offline install.
# =============================================================================
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS runtime

ARG GHIDRA_VERSION
LABEL org.opencontainers.image.title="vivarium-worker" \
      org.opencontainers.image.description="Hardened, network-isolated headless Ghidra analysis worker (TB3)." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/OWNER/vivarium-mcp" \
      org.vivarium.ghidra-version="${GHIDRA_VERSION}" \
      org.vivarium.trust-boundary="TB3-hostile-input" \
      org.vivarium.network="none"

# --- Base packages: Python 3.12 (PyGhidra runtime) + OpenJDK 21 (Ghidra JVM) + the python symlink.
# Wolfi resolves CURRENT package versions here (auto-patched); the digest-pinned base anchors
# reproducibility. The non-root identity uid/gid 65532 ("nonroot") is BUILT INTO the Wolfi base
# (CIS / topic-container-k8s) — no useradd needed (and gid 65532 is already taken); deploy/ maps
# ownership by that numeric uid/gid. Ghidra's writable home is forced to the tmpfs via HOME +
# -Duser.home below, so no created home dir is required.
RUN set -eux; \
    # CVE-2026-44432: floor py3-pip-wheel to the patched >=26.1.2-r1 (python-3.12 pulls it as a
    # transitive dep; the explicit constraint also busts the build-layer cache so a fresh resolve
    # gets the fix in CI, not a stale -r0 cached layer). py3-pip-wheel is build-bootstrap only — not
    # executed in the runtime — but we upgrade rather than waive (upgrade-first; ADR-003 spirit).
    # Force fixed base packages the pinned wolfi-base bakes vulnerable (upgrade-first, not a waiver
    # — workflow-cve-management; the explicit constraints also bust the layer cache so a fresh CI
    # resolve pulls the fixes):
    #   * CVE-2026-14456 (HIGH, openssl) — wolfi-base bakes libcrypto3/libssl3 3.6.3-r1; pin BOTH to
    #     r5 (they are separate apk packages — one constraint does NOT drag the other, proven).
    #   * CVE-2026-38753 + CVE-2026-38754 (HIGH, busybox) — baked 1.37.0-r60; pin the 1.38.0 fix.
    apk add --no-cache python-3.12 openjdk-21 "py3-pip-wheel>=26.1.2-r1" \
        "libcrypto3>=3.6.3-r5" "libssl3>=3.6.3-r5" "busybox>=1.38.0-r0"; \
    ln -sf /usr/bin/python3.12 /usr/bin/python; \
    ln -sf /usr/bin/python3.12 /usr/bin/python3

# --- JDK 21 (from apk; JAVA_HOME confirmed against the wolfi openjdk-21 layout) ------------------
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH="/usr/lib/jvm/java-21-openjdk/bin:${PATH}"

# --- Ghidra (from the fetch stage; upstream zip already SHA-256-verified) ------------------------
COPY --from=ghidra-fetch --chown=root:root /opt/ghidra /opt/ghidra
ENV GHIDRA_INSTALL_DIR=/opt/ghidra
ENV PATH="/opt/ghidra/support:${PATH}"

# --- Python: vivarium package + PyGhidra + the worker code -------------------------------------
# Install order is supply-chain-deliberate (std-supplychain) and OFFLINE for the final image:
#   1. Runtime deps from the HASH-PINNED lockfile (`--require-hashes`): tampered/substituted wheel
#      fails the build (fail closed). mcp + pydantic + transitive closure (cp312 wheels) live here.
#   2. The vivarium wheel PREBUILT in pybuilder, installed `--no-deps` + `--no-index`.
#   3. PyGhidra + JPype1 from the wheels BUNDLED inside the SHA-256-verified Ghidra dist, `--no-index`
#      (offline) — integrity inherited from the verified zip, better than an unpinned PyPI pull.
# pip is bootstrapped via ensurepip (Wolfi python-3.12 ships none). Installs into system
# site-packages (single-app image; rootfs is read-only at runtime).
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

# Inputs: the hash-pinned runtime lock, the prebuilt vivarium wheel, and the `worker/` modules.
# `worker/` is plain modules (NOT in the hatch wheel) on the import path; root-owned + ro-rootfs ⇒
# the worker user cannot modify its own code at runtime (defense in depth).
COPY --chown=root:root requirements.lock /opt/vivarium/requirements.lock
COPY --from=pybuilder --chown=root:root /build/dist /opt/vivarium/dist
COPY --chown=root:root worker/ /opt/vivarium-worker/worker/

# --- Bundled ELF FunctionID databases (ADR-043 Phase 2) ------------------------------------------
# The worker startup-attaches every *.fidbf under VIVARIUM_FID_DB_DIR (default /opt/vivarium/fid):
# it copies each to the writable tmpfs scratch and calls FidFileManager.addUserFidFile + setActive
# (the PROVEN activation mechanism — a data-dir drop-in is silently ignored; ADR-043 D3). The dir is
# root-owned (the read-only rootfs + non-root worker cannot tamper with the shipped DBs).
#
# COPY the deploy/fid scaffold (README + the CI-gated sources.toml manifest) so the dir always EXISTS
# (an empty dir ⇒ a clean no-op, identical to the pre-Phase-2 baseline — fail-soft).
# >>> PM-GATED: the actual permissive `.fidbf` artifacts are GENERATED during validation (the gated
# >>> zlib-static build stage + scripts/fid/generate_fidb.py) and dropped into deploy/fid/ (or a
# >>> dedicated build stage) so this COPY bakes them in. No real `.fidbf` is committed to the repo.
COPY --chown=root:root deploy/fid/ /opt/vivarium/fid/

ENV PYTHONPATH=/opt/vivarium-worker \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Pinned, hashed runtime deps; then the prebuilt wheel + bundled PyGhidra, both OFFLINE (--no-index).
# integration-validate: the bundled PyGhidra wheel path inside the 12.1.2 dist
#   /opt/ghidra/Ghidra/Features/PyGhidra/pypkg/dist/*.whl  (a built wheel + JPype1).
RUN set -eux; \
    PYGHIDRA_DIST="/opt/ghidra/Ghidra/Features/PyGhidra/pypkg/dist"; \
    python3.12 -m ensurepip --upgrade; \
    python3.12 -m pip install --no-cache-dir --require-hashes \
        --requirement /opt/vivarium/requirements.lock; \
    python3.12 -m pip install --no-cache-dir --no-deps --no-index \
        --find-links /opt/vivarium/dist vivarium-mcp; \
    test -d "${PYGHIDRA_DIST}" || { echo "PyGhidra dist not found at ${PYGHIDRA_DIST}" >&2; exit 1; }; \
    python3.12 -m pip install --no-cache-dir --no-index \
        --find-links "${PYGHIDRA_DIST}" pyghidra; \
    rm -rf /opt/vivarium/dist; \
    # Remove the unused Ghidra BSim postgres JDBC driver: Vivarium's BSim path computes LSH vectors
    # IN MEMORY (loadConfigurationTemplate + generateLSHVectorFactory + GenSignatures + VectorCompare)
    # and NEVER opens a FunctionDatabase/JDBC connection, so this jar is dead weight — its removal
    # clears Trivy CVE-2026-54291 (postgresql) with no functional impact (remove > waive).
    rm -f /opt/ghidra/Ghidra/Features/BSim/lib/postgresql-*.jar; \
    # Strip build-only python tooling from the SHIPPED image: the worker runs the analysis code and
    # never installs packages at runtime, so pip (with its bundled `_vendor/msgpack`), setuptools,
    # and wheel are dead weight — and Trivy's python-pkg scanner flags them (setuptools
    # CVE-2025-47273, msgpack GHSA-6v7p-g79w-8964). REMOVE rather than waive; the smoke imports below
    # then prove pyghidra + the worker still import without them (fail the build fast if not).
    python3.12 -m pip uninstall -y pip setuptools wheel 2>/dev/null || true; \
    python -c "import vivarium.ghidra._jvm_bridge"; \
    python -c "import worker, worker.dispatch, worker.server"; \
    python -c "import pyghidra"

# --- Runtime environment (mirrors security/limits.py defaults; deploy/ also passes these) --------
ENV VIVARIUM_RPC_SOCKET_DIR=/run/vivarium \
    VIVARIUM_ANALYSIS_TIMEOUT_SECONDS=600 \
    VIVARIUM_TOOL_TIMEOUT_SECONDS=60 \
    VIVARIUM_MAX_RESPONSE_BYTES=4194304 \
    VIVARIUM_MAX_BINARY_BYTES=134217728 \
    # JVM: cap the heap (deploy/ cgroup mem limit is the hard wall); -XX:+ExitOnOutOfMemoryError so a
    # heap OOM self-exits the JVM with code 3 → server classifies it `resource-exhausted` and evicts
    # (ADR-037; a native/off-heap overrun instead trips the cgroup OOM-kill = exit 137). No network
    # properties; Ghidra runs offline.
    # -Duser.home: Ghidra reads Java's `user.home` (not $HOME) from the passwd entry; point it at the
    # writable /tmp/ghidra tmpfs so Ghidra can save its JDK config + user settings under ro-rootfs.
    JAVA_TOOL_OPTIONS="-XX:+ExitOnOutOfMemoryError -XX:MaxRAMPercentage=75.0 -Djava.awt.headless=true -Djava.net.preferIPv4Stack=true -Djava.io.tmpdir=/tmp/ghidra -Duser.home=/tmp/ghidra"

# --- Scratch / writable surfaces -----------------------------------------------------------------
# The rootfs is READ-ONLY at runtime (deploy/). The worker writes ONLY to tmpfs mounts deploy/
# provides: the per-session project store + a JVM/tmp scratch. Declared here so the image is
# self-documenting and the dirs exist with correct ownership for the read-only-rootfs case.
RUN set -eux; \
    mkdir -p /run/vivarium /work/project /tmp/ghidra; \
    chown -R 65532:65532 /run/vivarium /work /tmp/ghidra; \
    chmod 0700 /run/vivarium /work/project

# Ghidra needs a WRITABLE home for its user settings + the JDK-config save and a writable
# java.io.tmpdir. The rootfs is read-only and the worker user has no created home, so point HOME at
# the /tmp/ghidra tmpfs (deploy/ mounts it; java.io.tmpdir + -Duser.home point there too).
ENV HOME=/tmp/ghidra
VOLUME ["/work/project"]

USER 65532:65532
WORKDIR /work

# --- Healthcheck ---------------------------------------------------------------------------------
# Liveness only — confirms the Python entrypoint can import its own code WITHOUT any network. The
# real readiness signal is the RPC `ping` over the UDS (rpc-protocol.md §4), driven by the server.
# Network-free by design; runs under the read-only rootfs (import-only; PYTHONDONTWRITEBYTECODE set).
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "-c", "import worker, vivarium.ghidra._jvm_bridge"]

# --- Entrypoint ----------------------------------------------------------------------------------
# The container runs ONLY the Python worker launcher (`worker/__main__.py`). It reconciles the
# per-session UDS path from VIVARIUM_SESSION_ID + VIVARIUM_RPC_SOCKET_DIR (deploy/worker-run.sh
# injects both), exports VIVARIUM_RPC_SOCKET, then runs worker_main() which binds the 0600 UDS,
# boots PyGhidra offline, and serves RPC writing only to /work/project + /tmp/ghidra. It exits
# non-zero on a missing session id or fatal error → the server maps the closed/absent socket to
# worker-unavailable and evicts (rpc-protocol.md §6).
ENTRYPOINT ["python", "-m", "worker"]

# =============================================================================
# Stage 4: zlib-fidgen — BUILD-TIME ONLY. Compile zlib UNSTRIPPED from pinned source, then run the
# PROVEN in-worker FID generate+pack recipe (scripts/fid/generate_fidb.py) to emit /out/zlib.fidbf.
# =============================================================================
# Bases on `runtime` to REUSE the already-assembled Ghidra + PyGhidra + JDK 21 + python layers (the
# generator needs the JVM/PyGhidra to run the createNewLibraryFromPrograms → PackedDatabase.pack
# recipe — ADR-043 D2). NOTHING from this stage ships to the worker image EXCEPT the packed
# .fidbf + its provenance manifest (COPY'd in the final stage); the C toolchain stays build-time.
#
# GATED ITEM W-ZLIB: zlib source tarball (downloaded + SHA-256-verified before extract, ARG-pinned).
# --- Stage 4a: zlib-build — compile zlib UNSTRIPPED from pinned source (wolfi OS toolchain) -------
# `runtime`/wolfi-base's default apk repo (apk.cgr.dev/chainguard) lacks the C toolchain, and this
# is a glibc base — so add the upstream wolfi OS repo (its signing key already ships in wolfi-base)
# and install gcc/make/GLIBC-dev (NOT musl-dev; tar is busybox-provided). Throwaway: only the built
# binary is COPY'd into the fidgen stage.
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS zlib-build

ARG ZLIB_VERSION
ARG ZLIB_TARBALL_SHA256
ARG ZLIB_TARBALL_URL
# AB1 (round-12): a sha256-verified FAIL-OVER mirror — the AA17 sibling. This zlib fetch feeds the
# `fid-probes` build behind the REQUIRED `fid-elf-match-gate`; a single-host (github/madler) outage
# on a FID-path PR would red the gate + block merges exactly as musl.libc.org did. zlib.net keeps
# every release under /fossils/ (canonical upstream, byte-identical to the github release); the
# checksum below makes the source irrelevant to integrity. Override via build-arg if needed.
ARG ZLIB_TARBALL_URL_FALLBACK=https://zlib.net/fossils/zlib-1.3.1.tar.gz

RUN set -eux; \
    echo "https://packages.wolfi.dev/os" >> /etc/apk/repositories; \
    apk add --no-cache ca-certificates curl gcc make glibc-dev

# --- Fetch + VERIFY zlib source (fail-closed on checksum mismatch — std-supplychain) -------------
# AB1: try the primary then the fail-over mirror; sha256-verify each, accept the first match, fail
# closed only if EVERY mirror is unreachable or none matches the pin.
WORKDIR /opt/zlib-src
RUN set -eux; \
    echo "${ZLIB_TARBALL_SHA256}  zlib.tar.gz" > zlib.tar.gz.sha256; \
    ok=""; \
    for url in "${ZLIB_TARBALL_URL}" "${ZLIB_TARBALL_URL_FALLBACK}"; do \
        echo "fetching zlib from ${url}"; \
        if curl -fsSL --retry 5 --retry-all-errors --retry-delay 15 --connect-timeout 60 --proto '=https' --tlsv1.2 -o zlib.tar.gz "${url}" && sha256sum -c zlib.tar.gz.sha256; then \
            ok=1; break; \
        fi; \
        rm -f zlib.tar.gz; \
    done; \
    test -n "${ok}" || { echo "all zlib mirrors failed (unreachable or checksum mismatch)" >&2; exit 1; }; \
    tar -xzf zlib.tar.gz; \
    rm -f zlib.tar.gz zlib.tar.gz.sha256

# --- Build zlib UNSTRIPPED (-g, symbols kept), x86-64 --------------------------------------------
# Build static libz.a, then a statically-linked, UNSTRIPPED executable that pulls EVERY zlib object
# in via --whole-archive so all zlib functions are DEFINED + NAMED in the analyzed binary (FID needs
# non-default-named functions large enough to clear the min-hash length — ADR-043 D2). No strip
# anywhere; -O2 -g keeps real, identifiable function bodies. A tiny driver gives the link an entry
# point. `nm`'s symbol table is written to a file (no pipe) and grepped, failing closed if zlib
# functions are missing/stripped (a stripped binary yields ~0 FID matches).
WORKDIR /opt/zlib-src/zlib-${ZLIB_VERSION}
# Build NON-PIC (no -fPIC) + link the executable -no-pie so the recovered zlib code matches
# the dominant real-world case of zlib statically linked into a non-PIE binary (PIC codegen routes
# global access through the GOT and changes instruction bytes, which would break FID full-hashes
# against non-PIE consumers — ADR-043 D2: match-rate over a PIC build).
# DL4006: `nm | awk | sort` allow-list gen on a LOCAL build artifact under `set -eux`; an nm
# failure → empty allow-list, caught downstream by `test -s` on the generated DB. A SHELL pipefail
# directive is avoided (wolfi /bin/sh pipefail support unverified; not worth a build-wide risk here).
# hadolint ignore=DL4006
RUN set -eux; \
    export CFLAGS="-O2 -g -fno-omit-frame-pointer"; \
    ./configure --static; \
    make -j"$(nproc)" libz.a; \
    printf '%s\n' \
        '#include <zlib.h>' \
        'int main(void){return (int)(zlibVersion()!=0);}' \
        > driver.c; \
    gcc -O2 -g -static -no-pie -fno-pie -I. -o /opt/zlib-fidgen.bin driver.c \
        -Wl,--whole-archive libz.a -Wl,--no-whole-archive; \
    nm /opt/zlib-fidgen.bin > /opt/zlib-fidgen.syms; \
    grep -q ' T inflate' /opt/zlib-fidgen.syms; \
    # zlib-ONLY function-name allow-list from the static archive (defined text/weak symbols). Scopes
    # the FID DB to zlib's own functions, EXCLUDING the statically-linked CRT/libc/libgcc functions
    # that would otherwise be mislabeled as zlib (false-positive library identification).
    nm --defined-only libz.a | awk '$2 ~ /^[TtWw]$/ {print $3}' | sort -u > /opt/zlib.allow; \
    test "$(wc -l < /opt/zlib.allow)" -gt 50; \
    grep -qx inflate /opt/zlib.allow; \
    grep -qx deflate /opt/zlib.allow

# --- Stage 4b: zlib-fidgen — run the PROVEN FID generate+pack recipe on the built binary ---------
# Bases on `runtime` to REUSE Ghidra + PyGhidra + JDK 21 + python (the generator needs the JVM —
# ADR-043 D2). Only the packed .fidbf + provenance ship (COPY'd in the final stage); ADR-001
# server-isolation is irrelevant in a build stage (no server here).
FROM runtime AS zlib-fidgen

ARG ZLIB_VERSION
ARG ZLIB_TARBALL_SHA256

# Build as root (runtime ends as USER 65532); Ghidra HOME/project live in this throwaway stage only.
USER root
COPY --from=zlib-build /opt/zlib-fidgen.bin /opt/zlib-fidgen.bin
COPY --from=zlib-build /opt/zlib.allow /opt/zlib.allow

# --- Run the PROVEN generator (scripts/fid/generate_fidb.py) → /out/zlib.fidbf (+ provenance) ----
# scripts/ is NOT in the runtime image, so COPY it into this build-only stage. The generator runs
# PyGhidra in-process (ADR-001 isolation is irrelevant in a build stage — there is no server here),
# analyzes the unstripped binary, and emits the packed .fidbf + its provenance manifest.
COPY --chown=root:root scripts/ /opt/vivarium-build/scripts/
WORKDIR /opt/vivarium-build
RUN set -eux; \
    mkdir -p /out /tmp/ghidra; \
    chmod 0777 /tmp/ghidra; \
    HOME=/tmp/ghidra PYTHONPATH=/opt/vivarium-worker python scripts/fid/generate_fidb.py \
        --input /opt/zlib-fidgen.bin \
        --output /out/zlib.fidbf \
        --family zlib \
        --version "${ZLIB_VERSION}" \
        --variant x86-64 \
        --license-spdx Zlib \
        --source-digest "sha256:${ZLIB_TARBALL_SHA256}" \
        --compiler "gcc (wolfi)" \
        --compiler-flags="-O2 -g -static -no-pie --whole-archive" \
        --include-symbols /opt/zlib.allow; \
    # Fail closed: the packed DB + its provenance manifest MUST exist for the final-stage COPY.
    test -s /out/zlib.fidbf; \
    test -s /out/zlib.fidbf.provenance.json

# Drop back to the runtime's non-root UID so no stage ends as root (Trivy DS-0002). This is a
# throwaway build stage — the generation RUN above already ran as root; this only resets the
# stage's trailing USER metadata.
USER 65532:65532

# =============================================================================
# Stage 4c: musl-build — compile musl libc UNSTRIPPED from pinned source (wolfi OS toolchain).
# =============================================================================
# GATED ITEM W-MUSL (ADR-043 Inc C). Same shape as zlib-build, but musl is a LIBC: its static
# archive (libc.a) DEFINES the same symbols as the build host's glibc, so instead of linking an
# executable (which drags in crt/glibc and the musl-gcc `-latomic_asneeded` self-spec) the whole
# archive is merged into one relocatable object via `ld -r --whole-archive` — every musl object in,
# no glibc clash, no driver. Throwaway: only the merged .o + allow-list cross the stage boundary;
# the C toolchain never ships.
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS musl-build

ARG MUSL_VERSION
ARG MUSL_TARBALL_SHA256
ARG MUSL_TARBALL_URL
# AA17 (round-11): a sha256-verified FAIL-OVER mirror. musl.libc.org is a single point of
# availability failure that flaked the worker build AND the required live-regression gate; because
# the tarball is checksum-verified below, the SOURCE is irrelevant to integrity — a mirror that
# serves tampered bytes fails the sha256 check exactly like the primary. The sabotage-linux mirror
# is a long-standing musl distfiles host. Override via build-arg if it too becomes unavailable.
ARG MUSL_TARBALL_URL_FALLBACK=https://ftp.barfooze.de/pub/sabotage/tarballs/musl-1.2.5.tar.gz

RUN set -eux; \
    echo "https://packages.wolfi.dev/os" >> /etc/apk/repositories; \
    apk add --no-cache ca-certificates curl gcc make

# --- Fetch + VERIFY musl source (fail-closed on checksum mismatch — std-supplychain) -------------
# AA17: try the primary, then the fail-over mirror; sha256-verify each candidate and accept the
# first that matches. Fails closed only if EVERY mirror is unreachable or none matches the pin.
WORKDIR /opt/musl-src
RUN set -eux; \
    echo "${MUSL_TARBALL_SHA256}  musl.tar.gz" > musl.tar.gz.sha256; \
    ok=""; \
    for url in "${MUSL_TARBALL_URL}" "${MUSL_TARBALL_URL_FALLBACK}"; do \
        echo "fetching musl from ${url}"; \
        if curl -fsSL --retry 5 --retry-all-errors --retry-delay 15 --connect-timeout 60 --proto '=https' --tlsv1.2 -o musl.tar.gz "${url}" && sha256sum -c musl.tar.gz.sha256; then \
            ok=1; break; \
        fi; \
        rm -f musl.tar.gz; \
    done; \
    test -n "${ok}" || { echo "all musl mirrors failed (unreachable or checksum mismatch)" >&2; exit 1; }; \
    tar -xzf musl.tar.gz; \
    rm -f musl.tar.gz musl.tar.gz.sha256

# --- Build musl UNSTRIPPED (-g, symbols kept), NON-PIC, x86-64 -----------------------------------
# `./configure --disable-shared` → static lib/libc.a, built NON-PIC (`-fno-omit-frame-pointer`, no
# -fPIC) so the recovered code matches the dominant statically-musl-linked non-PIE consumer (PIC
# routes globals through the GOT and changes instruction bytes — FID match-rate over a PIC build).
#
# To get every musl function DEFINED + NAMED in a single analyzable artifact WITHOUT linking an
# executable, merge the whole archive into one relocatable object with `ld -r --whole-archive`. This
# deliberately avoids the `musl-gcc` driver: under wolfi's gcc a `musl-gcc -static` link injects a
# `-latomic_asneeded` self-spec that has no static variant and fails the link. `ld -r` invokes the
# linker directly (no gcc specs, no crt/_start/glibc-symbol clash) and keeps -g/symbols. FID is
# relocation-tolerant by design (it masks call/reloc operands), so a DB built from this merged .o
# still matches musl functions in fully-linked consumers (ADR-043 D2). `nm` is written to a file (no
# pipe) and checked, failing closed if libc functions are missing/stripped.
WORKDIR /opt/musl-src/musl-${MUSL_VERSION}
# DL4006: as zlib — `nm | awk | sort` allow-list gen on a local artifact under `set -eux`;
# empty-on-failure is caught downstream by `test -s`. (SHELL pipefail avoided — wolfi sh unverified.)
# hadolint ignore=DL4006
RUN set -eux; \
    export CFLAGS="-O2 -g -fno-omit-frame-pointer"; \
    ./configure --prefix=/opt/musl --disable-shared; \
    make -j"$(nproc)"; \
    make install; \
    ld -r --whole-archive /opt/musl/lib/libc.a -o /opt/musl-fidgen.o; \
    nm /opt/musl-fidgen.o > /opt/musl-fidgen.syms; \
    grep -qE ' [TtWw] memcpy$' /opt/musl-fidgen.syms; \
    # musl-ONLY function-name allow-list from the static archive (defined text/weak symbols). Scopes
    # the FID DB to musl's own functions, EXCLUDING any CRT/compiler-runtime objects the link pulled
    # in that would otherwise be mislabeled as musl (false-positive library identification).
    nm --defined-only /opt/musl/lib/libc.a | awk '$2 ~ /^[TtWw]$/ {print $3}' | sort -u > /opt/musl.allow; \
    test "$(wc -l < /opt/musl.allow)" -gt 200; \
    grep -qx memcpy /opt/musl.allow; \
    grep -qx malloc /opt/musl.allow

# =============================================================================
# Stage 4d: musl-fidgen — run the PROVEN FID generate+pack recipe on the built musl binary.
# =============================================================================
# Bases on `runtime` to REUSE Ghidra + PyGhidra + JDK 21 + python (the generator needs the JVM —
# ADR-043 D2). Only the packed .fidbf + provenance ship (COPY'd in the final stage); ADR-001
# server-isolation is irrelevant in a build stage (no server here).
FROM runtime AS musl-fidgen

ARG MUSL_VERSION
ARG MUSL_TARBALL_SHA256

# Build as root (runtime ends as USER 65532); Ghidra HOME/project live in this throwaway stage only.
USER root
COPY --from=musl-build /opt/musl-fidgen.o /opt/musl-fidgen.o
COPY --from=musl-build /opt/musl.allow /opt/musl.allow

# scripts/ is NOT in the runtime image, so COPY it into this build-only stage and run the generator
# (PyGhidra in-process — ADR-001 isolation is irrelevant here, there is no server) over the merged
# unstripped musl relocatable object, scoped to musl's own functions via the allow-list.
COPY --chown=root:root scripts/ /opt/vivarium-build/scripts/
WORKDIR /opt/vivarium-build
RUN set -eux; \
    mkdir -p /out /tmp/ghidra; \
    chmod 0777 /tmp/ghidra; \
    HOME=/tmp/ghidra PYTHONPATH=/opt/vivarium-worker python scripts/fid/generate_fidb.py \
        --input /opt/musl-fidgen.o \
        --output /out/musl.fidbf \
        --family musl \
        --version "${MUSL_VERSION}" \
        --variant x86-64 \
        --license-spdx MIT \
        --source-digest "sha256:${MUSL_TARBALL_SHA256}" \
        --compiler "gcc (wolfi)" \
        --compiler-flags="-O2 -g -fno-omit-frame-pointer (non-PIC); ld -r --whole-archive libc.a" \
        --include-symbols /opt/musl.allow; \
    # Fail closed: the packed DB + its provenance manifest MUST exist for the final-stage COPY.
    test -s /out/musl.fidbf; \
    test -s /out/musl.fidbf.provenance.json

# Drop back to the runtime's non-root UID so no stage ends as root (Trivy DS-0002). Throwaway stage.
USER 65532:65532

# =============================================================================
# Stage 4e: openssl-build — compile OpenSSL libcrypto/libssl UNSTRIPPED from pinned source.
# =============================================================================
# GATED ITEM W-OPENSSL (ADR-043 Inc D). Same `ld -r --whole-archive` merge as musl. Built PIC
# (OpenSSL's default for static libs) ON PURPOSE: unlike zlib/musl, real OpenSSL static consumers are
# overwhelmingly PIE/PIC (the dominant statically-linked-openssl case is a PIE binary, and most
# OpenSSL is dynamically linked) — so a PIC DB matches the dominant consumer. `make build_libs` builds
# only libcrypto.a + libssl.a (skips the openssl app + tests/docs — a big time saver). Throwaway:
# only the merged .o + allow-list cross the stage boundary; the C toolchain + perl never ship.
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS openssl-build

ARG OPENSSL_VERSION
ARG OPENSSL_TARBALL_SHA256
ARG OPENSSL_TARBALL_URL
# AB2 (round-12): sha256-verified fail-over mirror (AA17 sibling; this fetch is on the image-scan-gate
# path). openssl.org/source publishes byte-identical release tarballs alongside the github release;
# checksum-gated so the source is irrelevant to integrity. Override via build-arg if needed.
ARG OPENSSL_TARBALL_URL_FALLBACK=https://www.openssl.org/source/openssl-3.5.7.tar.gz

RUN set -eux; \
    echo "https://packages.wolfi.dev/os" >> /etc/apk/repositories; \
    apk add --no-cache ca-certificates curl gcc make perl linux-headers

# --- Fetch + VERIFY OpenSSL source (fail-closed on checksum mismatch — std-supplychain) ----------
# AB2: primary then fail-over mirror; sha256-verify each, first match wins, fail closed if none.
WORKDIR /opt/openssl-src
RUN set -eux; \
    echo "${OPENSSL_TARBALL_SHA256}  openssl.tar.gz" > openssl.tar.gz.sha256; \
    ok=""; \
    for url in "${OPENSSL_TARBALL_URL}" "${OPENSSL_TARBALL_URL_FALLBACK}"; do \
        echo "fetching openssl from ${url}"; \
        if curl -fsSL --retry 5 --retry-all-errors --retry-delay 15 --connect-timeout 60 --proto '=https' --tlsv1.2 -o openssl.tar.gz "${url}" && sha256sum -c openssl.tar.gz.sha256; then \
            ok=1; break; \
        fi; \
        rm -f openssl.tar.gz; \
    done; \
    test -n "${ok}" || { echo "all openssl mirrors failed (unreachable or checksum mismatch)" >&2; exit 1; }; \
    tar -xzf openssl.tar.gz; \
    rm -f openssl.tar.gz openssl.tar.gz.sha256

# --- Build static libcrypto.a + libssl.a UNSTRIPPED (-g, symbols kept), x86-64 -------------------
# `no-shared` → static archives only; `no-tests no-docs no-apps` trims the build; `make build_libs`
# builds just the two libraries. Merge both into one relocatable object with `ld -r --whole-archive`
# (no executable link / crt; keeps -g/symbols). `nm` is written to a file (no pipe) and checked,
# failing closed if the crypto functions are missing/stripped.
WORKDIR /opt/openssl-src/openssl-${OPENSSL_VERSION}
# DL4006: as zlib — `nm | awk | sort` allow-list gen on a local artifact under `set -eux`;
# empty-on-failure is caught downstream by `test -s`. (SHELL pipefail avoided — wolfi sh unverified.)
# hadolint ignore=DL4006
RUN set -eux; \
    ./Configure no-shared no-tests no-docs no-apps linux-x86_64 -O2 -g -fno-omit-frame-pointer; \
    make -j"$(nproc)" build_libs; \
    ld -r --whole-archive libcrypto.a libssl.a -o /opt/openssl-fidgen.o; \
    nm /opt/openssl-fidgen.o > /opt/openssl-fidgen.syms; \
    grep -qE ' [TtWw] (SHA256_Init|EVP_EncryptInit_ex)$' /opt/openssl-fidgen.syms; \
    # OpenSSL-ONLY function-name allow-list from the static archives (defined text/weak symbols).
    nm --defined-only libcrypto.a libssl.a | awk '$2 ~ /^[TtWw]$/ {print $3}' | sort -u > /opt/openssl.allow; \
    test "$(wc -l < /opt/openssl.allow)" -gt 1000; \
    grep -qx EVP_EncryptInit_ex /opt/openssl.allow; \
    grep -qx SHA256_Init /opt/openssl.allow

# =============================================================================
# Stage 4f: openssl-fidgen — run the PROVEN FID generate+pack recipe on the built OpenSSL object.
# =============================================================================
FROM runtime AS openssl-fidgen

ARG OPENSSL_VERSION
ARG OPENSSL_TARBALL_SHA256

# Build as root (runtime ends as USER 65532); Ghidra HOME/project live in this throwaway stage only.
USER root
COPY --from=openssl-build /opt/openssl-fidgen.o /opt/openssl-fidgen.o
COPY --from=openssl-build /opt/openssl.allow /opt/openssl.allow

COPY --chown=root:root scripts/ /opt/vivarium-build/scripts/
WORKDIR /opt/vivarium-build
RUN set -eux; \
    mkdir -p /out /tmp/ghidra; \
    chmod 0777 /tmp/ghidra; \
    HOME=/tmp/ghidra PYTHONPATH=/opt/vivarium-worker python scripts/fid/generate_fidb.py \
        --input /opt/openssl-fidgen.o \
        --output /out/openssl.fidbf \
        --family openssl \
        --version "${OPENSSL_VERSION}" \
        --variant x86-64 \
        --license-spdx Apache-2.0 \
        --source-digest "sha256:${OPENSSL_TARBALL_SHA256}" \
        --compiler "gcc (wolfi)" \
        --compiler-flags="-O2 -g (PIC, OpenSSL default); ld -r --whole-archive libcrypto.a libssl.a" \
        --include-symbols /opt/openssl.allow; \
    # Fail closed: the packed DB + its provenance manifest MUST exist for the final-stage COPY.
    test -s /out/openssl.fidbf; \
    test -s /out/openssl.fidbf.provenance.json

# Drop back to the runtime's non-root UID so no stage ends as root (Trivy DS-0002). Throwaway stage.
USER 65532:65532

# =============================================================================
# Stage: fid-probes — same-toolchain consumer binaries for the DETERMINISTIC ELF-match gate.
# =============================================================================
# NOT shipped: worker-final does NOT COPY from here, so a normal `--target worker-final` build never
# builds this stage. A static probe embeds real library CODE, which would (a) bloat the runtime image
# and (b) trip Trivy image-SCA on the embedded library's CVEs — so it must stay out of the image.
# Instead the live-regression CI job builds THIS stage, extracts the probes, and imports them through
# the real worker. Each probe is compiled with the worker image's OWN toolchain (the same pinned wolfi
# gcc + pinned library source that produced the bundled .fidbf), so the FID match is DETERMINISTIC
# (same-toolchain) — a hard >=N gate, unlike the host-compiled, cross-toolchain (hence advisory)
# test_identify_functions_elf_match.py. ADR-043. Bases on zlib-build (wolfi gcc + libz.a + zlib src);
# musl's toolchain + static libc is copied in.
FROM zlib-build AS fid-probes

ARG ZLIB_VERSION

COPY --from=musl-build /opt/musl /opt/musl

# DL4006: the `nm <probe> | grep -qE` symbol asserts run on just-built local probes under `set -eux`
# — an nm failure yields empty input, so `grep -q` exits non-zero and fails the RUN anyway. (SHELL
# pipefail avoided — wolfi sh unverified.)
# hadolint ignore=DL4006
RUN set -eux; \
    mkdir -p /opt/fid-probes; \
    # --- zlib consumer (static, wolfi gcc): embeds real zlib functions to identify -----------------
    printf '%s\n' \
        '#include <zlib.h>' \
        '#include <string.h>' \
        'int main(int argc, char **argv){(void)argv;unsigned char in[64],out[128];' \
        'memset(in,(unsigned char)argc,sizeof in);z_stream s;memset(&s,0,sizeof s);' \
        'if(deflateInit(&s,Z_DEFAULT_COMPRESSION)!=Z_OK)return 1;' \
        's.next_in=in;s.avail_in=sizeof in;s.next_out=out;s.avail_out=sizeof out;' \
        'deflate(&s,Z_FINISH);deflateEnd(&s);' \
        'unsigned long c=crc32(0L,in,sizeof in);return (int)(c&0x7f);}' \
        > /tmp/zlib_probe.c; \
    gcc -O2 -g -static -no-pie -fno-pie -I /opt/zlib-src/zlib-${ZLIB_VERSION} \
        -o /opt/fid-probes/zlib_probe /tmp/zlib_probe.c \
        -L /opt/zlib-src/zlib-${ZLIB_VERSION} -lz; \
    nm /opt/fid-probes/zlib_probe | grep -qE ' [TtWw] deflate$'; \
    # --- musl consumer (static, musl-gcc): empty libatomic_asneeded stub satisfies wolfi's gcc spec -
    ar rc /opt/musl/lib/libatomic_asneeded.a; \
    printf '%s\n' \
        '#include <stdlib.h>' \
        '#include <string.h>' \
        'static int cmp(const void*a,const void*b){return *(const int*)a-*(const int*)b;}' \
        'int main(int argc, char **argv){char*b=malloc(64);if(!b)return 1;memset(b,0,64);' \
        'memcpy(b,"vivarium",8);size_t n=strlen(b);int v[8];' \
        'for(int i=0;i<8;i++)v[i]=(int)strtol(argv[0]+(i%n),NULL,10)+(8-i);' \
        'qsort(v,8,sizeof(int),cmp);int a=(int)n+(strcmp(b,"vivarium")==0?1:0);' \
        'for(int i=0;i<8;i++)a+=v[i];free(b);return a&0x7f;}' \
        > /tmp/musl_probe.c; \
    /opt/musl/bin/musl-gcc -O2 -g -static -no-pie -fno-pie \
        -o /opt/fid-probes/musl_probe /tmp/musl_probe.c; \
    nm /opt/fid-probes/musl_probe | grep -qE ' [TtWw] memcpy$'

# =============================================================================
# Stage 4g: boost-build — compile Boost's COMPILED libraries UNSTRIPPED from pinned source.
# =============================================================================
# GATED ITEM W-BOOST (ADR-043 Inc E). Boost is C++ and mostly header-only; only its COMPILED libs
# carry function bodies to fingerprint. Build a dependency-light, high-value subset with Boost.Build
# (`./bootstrap.sh` → `./b2 ... stage`), link=static, then merge every staged libboost_*.a into one
# relocatable object via `ld -r --whole-archive` (same as musl/openssl). C++ NOTE: the DB is NOT
# symbol-scoped (`--include-symbols` is omitted in the fidgen step) because the merged .o is pure
# Boost (no CRT/libc to mislabel) AND Ghidra DEMANGLES C++ names, which a mangled `nm` allow-list
# would not match — so scoping would wrongly empty the DB. Throwaway: only the merged .o ships out.
FROM cgr.dev/chainguard/wolfi-base@sha256:0b5fd36c9f36ecc95bf6dbe049fe0a211410e1ba8a9801db0fbe25c7561d81c1 AS boost-build

ARG BOOST_VERSION
ARG BOOST_TARBALL_SHA256
ARG BOOST_TARBALL_URL

RUN set -eux; \
    echo "https://packages.wolfi.dev/os" >> /etc/apk/repositories; \
    # wolfi's `gcc` package ships the C++ driver (g++/c++) too — there is no separate `g++` package.
    apk add --no-cache ca-certificates curl gcc make bash

# --- Fetch + VERIFY Boost source (fail-closed on checksum mismatch — std-supplychain) ------------
# AB2 (round-12) note: the pinned artifact is the GitHub-release-specific `boost-1.89.0-b2-nodocs.tar.gz`
# (docs stripped) — the boostorg archive hosts (archives.boost.io) serve the FULL `boost_1_89_0.tar.gz`,
# a DIFFERENT file with a different sha256, so no sha-matching fail-over mirror exists for this variant.
# Accepted: image-scan-gate path (not the FID required gate), high-availability host, checksum-gated.
WORKDIR /opt/boost-src
RUN set -eux; \
    echo "${BOOST_TARBALL_SHA256}  boost.tar.gz" > boost.tar.gz.sha256; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 15 --connect-timeout 60 --proto '=https' --tlsv1.2 -o boost.tar.gz "${BOOST_TARBALL_URL}"; \
    sha256sum -c boost.tar.gz.sha256; \
    tar -xzf boost.tar.gz; \
    rm -f boost.tar.gz boost.tar.gz.sha256

# --- Build a curated set of COMPILED Boost libs (static, UNSTRIPPED, -g) -------------------------
# The `--with-*` set is deliberately dependency-light (no python/ICU/zlib/bzip2) so the build is
# reliable + bounded while still covering the most common compiled Boost libraries. `ld -r` merges
# all staged archives into one object with every Boost function DEFINED + NAMED.
WORKDIR /opt/boost-src/boost-${BOOST_VERSION}
RUN set -eux; \
    ./bootstrap.sh --with-toolset=gcc; \
    ./b2 -j"$(nproc)" toolset=gcc link=static runtime-link=static variant=release \
        cxxflags="-O2 -g -fno-omit-frame-pointer" --layout=system \
        --with-system --with-filesystem --with-program_options --with-thread \
        --with-chrono --with-atomic --with-date_time --with-container \
        --with-random --with-regex --with-exception --with-charconv --with-json \
        stage; \
    ls -la stage/lib/*.a; \
    ld -r --whole-archive stage/lib/libboost_*.a -o /opt/boost-fidgen.o; \
    nm /opt/boost-fidgen.o > /opt/boost-fidgen.syms; \
    grep -qE ' [TtWw] .*5boost' /opt/boost-fidgen.syms; \
    test "$(grep -cE ' [TtWw] ' /opt/boost-fidgen.syms)" -gt 300

# --- Same-toolchain Boost CONSUMER for the FID match-validation (ADR-043 Inc E; NOT shipped) -----
# Its Boost function bodies come from the SAME staged libboost_*.a that produced boost-fidgen.o, so
# they are byte-identical to the DB's source → a deterministic same-toolchain match. Boost libs are
# static (.a), so they link in regardless of -static; keep libc/libstdc++ dynamic (only the Boost
# bodies need to be present for FID). Consumed only by the throwaway `boost-match-check` stage below.
RUN set -eux; \
    ls -la stage/lib/*.a; \
    printf '%s\n' \
        '#include <boost/filesystem.hpp>' \
        '#include <boost/regex.hpp>' \
        '#include <string>' \
        'int main(int argc, char** argv){' \
        '  boost::filesystem::path p(argc>0?argv[0]:".");' \
        '  bool e=boost::filesystem::exists(p);' \
        '  boost::regex re("[a-z]+[0-9]*");' \
        '  std::string s(argc>1?argv[1]:"vivarium123");' \
        '  bool m=boost::regex_search(s,re);' \
        '  return (e?1:0)+(m?2:0);}' \
        > /tmp/boost_consumer.cpp; \
    # Boost.System is header-only (>=1.69) — no libboost_system.a. Link every staged archive inside
    # a --start-group so inter-library circular refs resolve; only needed symbols are pulled in.
    g++ -O2 -g -no-pie -fno-pie /tmp/boost_consumer.cpp -I . \
        -Wl,--start-group stage/lib/libboost_*.a -Wl,--end-group \
        -o /opt/boost_consumer; \
    nm /opt/boost_consumer > /opt/boost_consumer.syms; \
    grep -qiE ' [Tt] .*boost' /opt/boost_consumer.syms

# =============================================================================
# Stage 4h: boost-fidgen — run the PROVEN FID generate+pack recipe on the merged Boost object.
# =============================================================================
FROM runtime AS boost-fidgen

ARG BOOST_VERSION
ARG BOOST_TARBALL_SHA256

# Build as root (runtime ends as USER 65532); Ghidra HOME/project live in this throwaway stage only.
USER root
COPY --from=boost-build /opt/boost-fidgen.o /opt/boost-fidgen.o

COPY --chown=root:root scripts/ /opt/vivarium-build/scripts/
WORKDIR /opt/vivarium-build
# No --include-symbols: the .o is pure Boost (nothing to mislabel) and Ghidra demangles C++ names,
# which a mangled allow-list would not match — so include ALL functions (ADR-043 Inc E).
RUN set -eux; \
    mkdir -p /out /tmp/ghidra; \
    chmod 0777 /tmp/ghidra; \
    HOME=/tmp/ghidra PYTHONPATH=/opt/vivarium-worker python scripts/fid/generate_fidb.py \
        --input /opt/boost-fidgen.o \
        --output /out/boost.fidbf \
        --family boost \
        --version "${BOOST_VERSION}" \
        --variant x86-64 \
        --license-spdx BSL-1.0 \
        --minimal-analysis \
        --source-digest "sha256:${BOOST_TARBALL_SHA256}" \
        --compiler "g++ (wolfi)" \
        --compiler-flags="-O2 -g (C++, link=static); ld -r --whole-archive libboost_*.a"; \
    # Fail closed: the packed DB + its provenance manifest MUST exist for the final-stage COPY.
    test -s /out/boost.fidbf; \
    test -s /out/boost.fidbf.provenance.json

# Drop back to the runtime's non-root UID so no stage ends as root (Trivy DS-0002). Throwaway stage.
USER 65532:65532

# =============================================================================
# Stage 4i: boost-match-check — VALIDATE the minimal-analysis Boost DB actually MATCHES (ADR-043 Inc E).
# =============================================================================
# NOT shipped (worker-final does NOT COPY from here). Answers the question the --minimal-analysis DB
# raises: does a DB built with REDUCED analysis match a Boost consumer analyzed NORMALLY? Attaches the
# bundled boost.fidbf, opens+FULL-analyzes the same-toolchain consumer, and queries FID. A build
# failure here = the minimal-analysis DB does not match (fall back to per-library split, plan C).
# Build with `--target boost-match-check` to run the gate; `--target worker-final` never builds it.
FROM boost-fidgen AS boost-match-check
USER root
# The harness lives under scripts/fid/ (baked into this image by the boost-fidgen `COPY scripts/`
# above; tests/ is .containerignore'd because tests are MOUNTED at runtime, not baked).
COPY --from=boost-build /opt/boost_consumer /work/input.bin
RUN set -eux; \
    mkdir -p /work/project /tmp/ghidra; \
    chmod 0777 /work/project /tmp/ghidra; \
    BOOST_FIDBF=/out/boost.fidbf BOOST_CONSUMER=/work/input.bin \
        HOME=/tmp/ghidra PYTHONPATH=/opt/vivarium-worker \
        python /opt/vivarium-build/scripts/fid/boost_match_check_inworker.py
USER 65532:65532

# =============================================================================
# Stage 5: worker-final — the shipped worker image = `runtime` + the build-generated FID DBs.
# =============================================================================
# Default build target (last stage). Overlays ONLY the packed .fidbf files + provenance onto the
# already-baked deploy/fid scaffold (README + sources.toml) from `runtime`, so the worker startup-
# attaches the REAL zlib + musl + openssl + boost DBs and identify_functions matches them (ADR-043 D3).
FROM runtime AS worker-final
COPY --from=zlib-fidgen --chown=root:root /out/zlib.fidbf /opt/vivarium/fid/zlib.fidbf
COPY --from=zlib-fidgen --chown=root:root \
    /out/zlib.fidbf.provenance.json /opt/vivarium/fid/zlib.fidbf.provenance.json
COPY --from=musl-fidgen --chown=root:root /out/musl.fidbf /opt/vivarium/fid/musl.fidbf
COPY --from=musl-fidgen --chown=root:root \
    /out/musl.fidbf.provenance.json /opt/vivarium/fid/musl.fidbf.provenance.json
COPY --from=openssl-fidgen --chown=root:root /out/openssl.fidbf /opt/vivarium/fid/openssl.fidbf
COPY --from=openssl-fidgen --chown=root:root \
    /out/openssl.fidbf.provenance.json /opt/vivarium/fid/openssl.fidbf.provenance.json
COPY --from=boost-fidgen --chown=root:root /out/boost.fidbf /opt/vivarium/fid/boost.fidbf
COPY --from=boost-fidgen --chown=root:root \
    /out/boost.fidbf.provenance.json /opt/vivarium/fid/boost.fidbf.provenance.json

# The shipped worker runs as the runtime's non-root UID (inherited from `runtime`); state it
# explicitly so the final image's USER is unambiguously non-root (topic-container-k8s; Trivy DS-0002).
USER 65532:65532
