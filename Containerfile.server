# syntax=docker/dockerfile:1
# =============================================================================
# Containerfile.server — the ghidra-mcp MCP control-plane server
# =============================================================================
# The TRUSTED control plane (validation, sessions, transport, worker lifecycle). Per ADR-001 it
# NEVER loads the JVM or parses a binary — so this image carries NO Ghidra and NO JDK. It speaks
# MCP over **stdio only** in v1 (PLAN §2): NO ports are exposed.
#
# The server is the sole client of each worker over a per-session UDS (rpc-protocol.md). To spawn
# workers it must reach a container runtime — that wiring lives in deploy/ (the runtime socket is a
# deliberate, reviewed mount; NOT baked into this image). This image is minimal, non-root, and run
# read-only by deploy/.
#
# -----------------------------------------------------------------------------
# BASE: Chainguard/Wolfi `python` (distroless migration — PLAN §9, server-first proof)
# -----------------------------------------------------------------------------
# Migrated OFF `python:3.12-slim` (Debian) to `cgr.dev/chainguard/python` (Wolfi) to durably retire
# the no-upstream-fix Debian-base CVEs that were waived in `.trivyignore.yaml` (perl-base, ncurses).
# Chainguard `python` is glibc-based (manylinux wheels resolve — pydantic-core etc.), ships a
# current Python 3.12, runs as the built-in non-root `nonroot` (uid/gid 65532), and carries NO
# shell / NO package manager / ~0 known CVEs. The build venv is produced in the `-dev` variant
# (shell + pip) and copied into the shell-free runtime — the standard Chainguard multi-stage pattern.
#
# Consequences of a shell-free runtime (vs. the old slim image):
#   * NO `RUN` in the runtime stage (no shell): the non-root user already exists (no useradd), and
#     the socket-dir mount point is baked in the builder then COPY'd (deploy/ tmpfs-mounts over it).
#   * The worker image (Containerfile.worker) still uses `python:3.12-slim` (its JDK+Ghidra
#     distroless migration is a separate, harder spike — PLAN §9), so the `.trivyignore.yaml`
#     waivers remain in force for the worker scan until that lands.
#
# -----------------------------------------------------------------------------
# SUPPLY CHAIN (std-supplychain) — DIGEST PINNING IS GATED (PLAN §6)
# -----------------------------------------------------------------------------
#   GATED ITEM S1: base build image (Chainguard python `-dev`: pip + shell for the wheel/venv)
#   GATED ITEM S2: base runtime image (Chainguard python: shell-free, non-root, minimal)
# Pinned by digest via the `@REPLACE_WITH_DIGEST_FOR_<image:tag>` placeholder that
# `infra/pin-supply-chain.sh` resolves on the gated build host. NOTE: Chainguard's free tier
# publishes only the `:latest` tag, so the *tag* is mutable but the *digest* we pin is immutable
# and always-current — re-pinned on each gated rebuild (a feature for security currency).
#
# Dependencies install from the HASH-PINNED lockfile only (--require-hashes). Generating that lock
# is itself gated (see pyproject.toml lockfile-intent note); until it exists, the build COPY +
# install of the lock is the single place a maintainer points at the committed lockfile.
# =============================================================================

# =============================================================================
# Stage 1: builder — build the wheel + install deps from the hash-pinned lock into a venv.
# =============================================================================
# GATED ITEM S1: pin this base by digest. `-dev` carries a shell + pip + build tooling (none of
# which ship to the runtime stage). hadolint DL3007: `:latest` is intentional + digest-pinned
# (Chainguard free tier is :latest-only); the digest is the real pin.
# hadolint ignore=DL3007
FROM cgr.dev/chainguard/python:latest-dev@sha256:cdd4cc5ab682d51162af0be628ceeca4e938b8fc8c7fcf2a486f810849abaed6 AS builder

# `-dev` defaults to the non-root user; switch to root to own /venv + /run during the build.
USER root

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Copy only what the build needs (better layer caching; smaller context).
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY src ./src
# COORDINATION: the hash-pinned lockfile (uv.lock / requirements.lock) is GATED to generate.
# Once committed, uncomment the COPY + the --require-hashes install below (fail-closed: no floating
# resolve in the image build). Until then this stage documents the intended supply-chain-safe path.
# COPY requirements.lock ./

RUN set -eux; \
    python -m venv /venv; \
    /venv/bin/pip install --no-cache-dir --upgrade pip; \
    # SUPPLY-CHAIN SAFE INSTALL (enable once the lockfile exists — GATED):
    #   /venv/bin/pip install --no-cache-dir --require-hashes -r requirements.lock
    # Then install the project itself (no deps; they came from the pinned lock):
    #   /venv/bin/pip install --no-cache-dir --no-deps .
    # Placeholder until the lock lands — documented, not a floating prod install path:
    /venv/bin/pip install --no-cache-dir --no-deps .; \
    # Bake the per-session socket-dir mount point with the runtime user's ownership: the runtime
    # stage is shell-free (cannot mkdir), and deploy/ tmpfs-mounts over this path at run time.
    mkdir -p /run/ghidra-mcp; \
    chown 65532:65532 /run/ghidra-mcp; \
    chmod 0700 /run/ghidra-mcp; \
    # Build-time smoke: the venv must import the package AND resolve the console script. This is the
    # one place a venv/Python-minor mismatch between `-dev` and the runtime base would surface early.
    /venv/bin/python -c "import ghidra_mcp"; \
    test -x /venv/bin/ghidra-mcp

# =============================================================================
# Stage 2: runtime — minimal, shell-free Chainguard python + the venv. No build tools, no pip.
# =============================================================================
# GATED ITEM S2: pin this base by digest. Shell-free, non-root (uid/gid 65532), no package manager.
# hadolint ignore=DL3007
FROM cgr.dev/chainguard/python:latest@sha256:15c25640085de8df6ea342f0f4a0064b85ebb5c6e1fcc306c59f78724c070c9a AS runtime

LABEL org.opencontainers.image.title="ghidra-mcp-server" \
      org.opencontainers.image.description="Secure MCP control-plane server for headless Ghidra (stdio, v1)." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/OWNER/ghidra-mcp" \
      org.ghidra-mcp.role="control-plane" \
      org.ghidra-mcp.transport="stdio" \
      org.ghidra-mcp.ports="none"

# No JVM here (ADR-001) — server only. The non-root `nonroot` user (uid/gid 65532) is built into the
# Chainguard base; there is no shell/useradd to create one (and none is needed).
ENV PATH="/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Structured JSON logs to stdout/stderr (12-Factor / topic-logging-observability).
    GHIDRA_MCP_LOG_FORMAT=json \
    GHIDRA_MCP_LOG_LEVEL=INFO \
    # Per-session RPC sockets live here; deploy/ mounts this as a private 0700 dir shared with
    # workers (server is owner). No network surface (rpc-protocol.md §2).
    GHIDRA_MCP_RPC_SOCKET_DIR=/run/ghidra-mcp

# The venv (root-owned, read-only at runtime) and the pre-owned socket-dir mount point, both lifted
# from the builder (the runtime stage has no shell to create them). integration-validate: the venv
# is portable because `-dev` and this runtime share the same Chainguard CPython install path; the
# gated build's smoke (above) + the post-build `ghidra-mcp` import confirm it.
COPY --from=builder --chown=root:root /venv /venv
COPY --from=builder --chown=65532:65532 /run/ghidra-mcp /run/ghidra-mcp

USER 65532:65532
WORKDIR /home/nonroot

# No HEALTHCHECK: a stdio MCP server has no port/endpoint to probe. Liveness is the process itself
# (the MCP client over stdio is the health signal). Adding a network probe would be misleading.

# stdio MCP entrypoint (the only transport in v1). NO EXPOSE — no ports in v1.
ENTRYPOINT ["ghidra-mcp"]
